if(CASE STREQUAL "warning")
    set(_arg "${FIXTURES}/warning.uc")
    set(_exit 0)
    set(_match "UMC_LOCAL_NEVER_READ")
elseif(CASE STREQUAL "accepted")
    set(_arg "${FIXTURES}/accepted.uc")
    set(_exit 0)
    set(_match "0 warning\\(s\\)")
elseif(CASE STREQUAL "syntax")
    set(_arg "${FIXTURES}/syntax.uc")
    set(_exit 2)
    set(_match "error:")
elseif(CASE STREQUAL "capacity")
    set(_arg "${FIXTURES}/capacity.uc")
    set(_exit 1)
    set(_match "Source check could not complete")
elseif(CASE STREQUAL "missing")
    set(_arg "${FIXTURES}/absent.uc")
    set(_exit 1)
    set(_match "Source check could not complete")
elseif(CASE STREQUAL "relative")
    set(_arg "warning.uc")
    set(_exit 1)
    set(_match "Source check could not complete")
elseif(CASE STREQUAL "help")
    set(_arg "--help")
    set(_exit 0)
    set(_match "without executing or saving code")
elseif(CASE STREQUAL "usage")
    set(_arg)
    set(_exit 64)
    set(_match "Usage:")
else()
    message(FATAL_ERROR "Unknown command case")
endif()
execute_process(COMMAND "${TOOL}" ${_arg}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 15)
if(NOT _result STREQUAL "${_exit}" OR NOT "${_out}${_err}" MATCHES "${_match}")
    message(FATAL_ERROR "Expected exit ${_exit} and ${_match}; got ${_result}: ${_out}${_err}")
endif()
