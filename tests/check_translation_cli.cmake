string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _id)
set(_dir "${ROOT}/${CASE}-${_id}")
file(MAKE_DIRECTORY "${_dir}")
set(_c "${_dir}/answer.c")
set(_java "${_dir}/UmicomAnswer.java")
set(_source "int answer(void) { return (20 + 1) * 2; }\n")
set(_java_source "public final class UmicomAnswer { public static int answer() { return (20 + 1) * 2; } }\n")
file(WRITE "${_c}" "${_source}")
set(_args c-to-java "${_c}" "${_java}")
set(_expected 0)
set(_output "${_java}")
set(_pattern "public static int answer")

if(CASE STREQUAL "java-to-c")
    file(WRITE "${_java}" "${_java_source}")
    set(_output "${_dir}/translated.c")
    set(_args java-to-c "${_java}" "${_output}")
    set(_pattern "int answer[(]void[)]")
elseif(CASE STREQUAL "invalid")
    set(_source "int answer(void) { return 8 / 0; }\n")
    file(WRITE "${_c}" "${_source}")
    set(_expected 2)
elseif(CASE STREQUAL "existing")
    file(WRITE "${_java}" "keep this file\n")
    set(_expected 1)
elseif(CASE STREQUAL "same")
    set(_args c-to-java "${_c}" "${_c}")
    set(_expected 1)
elseif(CASE STREQUAL "relative-input")
    set(_args c-to-java answer.c "${_java}")
    set(_expected 1)
elseif(CASE STREQUAL "relative-output")
    set(_args c-to-java "${_c}" UmicomAnswer.java)
    set(_expected 1)
elseif(CASE STREQUAL "missing")
    set(_args c-to-java "${_dir}/missing.c" "${_java}")
    set(_expected 1)
elseif(CASE STREQUAL "oversize")
    string(REPEAT " " 65537 _source)
    file(WRITE "${_c}" "${_source}")
    set(_expected 1)
elseif(CASE STREQUAL "no-parent")
    set(_output "${_dir}/missing/UmicomAnswer.java")
    set(_args c-to-java "${_c}" "${_output}")
    set(_expected 1)
elseif(CASE STREQUAL "help")
    set(_args --help)
elseif(CASE STREQUAL "usage")
    set(_args unknown "${_c}" "${_java}")
    set(_expected 64)
elseif(NOT CASE STREQUAL "c-to-java")
    message(FATAL_ERROR "Unknown translation check ${CASE}")
endif()

execute_process(COMMAND "${TOOL}" ${_args} WORKING_DIRECTORY "${_dir}"
    RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
if(NOT _exit STREQUAL "${_expected}")
    message(FATAL_ERROR "${CASE} exited ${_exit}, expected ${_expected}\n${_stdout}\n${_stderr}")
endif()
file(READ "${_c}" _unchanged)
if(NOT _unchanged STREQUAL _source)
    message(FATAL_ERROR "Input C file changed")
endif()
if(CASE STREQUAL "help")
    if(NOT _stdout MATCHES "Usage: umicom-studio-translate")
        message(FATAL_ERROR "Help did not document the command")
    endif()
elseif(CASE STREQUAL "existing")
    file(READ "${_java}" _unchanged)
    if(NOT _unchanged STREQUAL "keep this file\n")
        message(FATAL_ERROR "Existing destination changed")
    endif()
elseif(_exit STREQUAL "0")
    file(READ "${_output}" _translated)
    if(NOT _translated MATCHES "${_pattern}" OR NOT _translated MATCHES "[(]20 [+] 1[)] [*] 2")
        message(FATAL_ERROR "Generated source changed the approved expression: ${_translated}")
    endif()
    if(CASE STREQUAL "java-to-c")
        file(READ "${_java}" _unchanged)
        if(NOT _unchanged STREQUAL _java_source)
            message(FATAL_ERROR "Input Java file changed")
        endif()
    endif()
elseif(EXISTS "${_output}")
    message(FATAL_ERROR "Refusal created an output file")
elseif(CASE STREQUAL "invalid" AND NOT _stderr MATCHES "answer[.]c:1:[1-9][0-9]*: division by zero")
    message(FATAL_ERROR "Refusal did not identify a source location and reason: ${_stderr}")
endif()
